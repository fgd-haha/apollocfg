# apollocfg 环境变量示例
# 复制为 .env 后按实际环境填写（需要 pip install apollocfg[dotenv] 才会自动加载）

# ---- 地址：二者至少设一个 ----
# meta server：先查 /services/config 发现 Config Service 实例，失败时自动轮换（推荐）
APOLLO_META_SERVER=http://localhost:8080
# 直连某个 Config Service，不做服务发现
# APOLLO_CONFIG_URL=http://localhost:8080

# ---- 应用标识 ----
# 在 Apollo Portal 创建应用时登记的 AppId
APOLLO_APP_ID=my-app
APOLLO_CLUSTER=default
APOLLO_NAMESPACES=application

# 环境名，仅用于日志与缓存键的标识
# APOLLO_ENV=DEV

# 灰度发布用的客户端 IP，留空则不上报
# APOLLO_CLIENT_IP=

# ---- 访问密钥（可选）----
# Apollo 1.6+ 为应用开启访问密钥后必填；留空走匿名访问
# APOLLO_ACCESS_KEY_SECRET=

# ---- 配置契约 ----
# 必须从 Apollo 解析出值的 key，逗号分隔。缺失时：
#   APOLLO_ALLOW_FALLBACK=false -> 抛 RequiredKeysMissing，拒绝启动
#   APOLLO_ALLOW_FALLBACK=true  -> 仅告警，由调用方静态配置兜底
# APOLLO_REQUIRED_KEYS=MYSQL_DSN,REDIS_URL

# 禁止热更新的 key，逗号分隔。启动时快照，运行期不随 Apollo 变化，
# 变更也不会出现在回调里。适用于连接池类配置——池不会因为配置变了就重建，
# 让值"看起来"变了反而危险。
# APOLLO_FROZEN_KEYS=MYSQL_DSN,REDIS_URL

# Apollo 不可达时是否允许降级（默认 true）
# APOLLO_ALLOW_FALLBACK=true
